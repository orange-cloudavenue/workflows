{% include '../common/header.yml.tmpl' %}

header: # `header` section is configurations for source codes license header.
  license:
    copyright-owner: Orange # the copyright owner to replace the [owner] in the `spdx-id` template.
    {% if license == "Apache-2.0" %}
    spdx-id: Apache-2.0 # the spdx id of the license, it's convenient when your license is standard SPDX license.
    content: |
      SPDX-FileCopyrightText: Copyright (c) [year] [owner]
      SPDX-License-Identifier: Apache-2.0

    pattern: |
      # Matches normalized text content of old headers (comment markers stripped by license-eye)
      SPDX-FileCopyrightText: Copyright \(c\) \d{4}(-\d{4})? Orange[\s\S]*?SPDX-License-Identifier: (Apache-2\.0|Apache License 2\.0)
    {% elif license == "MPL-2.0" %}
    spdx-id: MPL-2.0
    content: |
      SPDX-FileCopyrightText: Copyright (c) [year] [owner]
      SPDX-License-Identifier: MPL-2.0

    pattern: |
      # Matches normalized text content of old headers (comment markers stripped by license-eye)
      SPDX-FileCopyrightText: Copyright \(c\) \d{4}(-\d{4})? Orange[\s\S]*?SPDX-License-Identifier: (MPL-2\.0|Mozilla Public License 2\.0)
    {% endif %}

  paths: # `paths` are the path list that will be checked (and fixed) by license-eye, default is ['**'].
    - '**'

  paths-ignore: # `paths-ignore` are the path list that will be ignored by license-eye.
    - 'dist'
    - 'licenses'
    - '**/*.md'
    - '**/testdata/**'
    - '**/go.mod'
    - '**/go.sum'
    - '**/go.work'
    - '**/go.work.sum'
    - 'LICENSE'
    - 'LICENCE'
    - 'NOTICE'
    - "**/CODEOWNERS"
    - '**/**.svg'
    - "**/zz_generated*.go"
    - "GNUmakefile"
    - "Makefile"
    - "**/*.json"
    - ".gitignore"
    - "**/.gitkeep"
    - "**/*.tmpl"
    - "**/*.tf"
    - ".changelog/"
    - "**/.changelog/"
    - ".archive/"
    - ".github/"
    - ".vscode/"
    - "**/*.code-snippets"
    - ".github"
    - ".pre-commit"
    - ".licenserc.yaml"
    - ".golangci.yml"
    - ".pre-commit-config.yaml"
    - "mkdocs.yml"
    - ".devcontainer/"
    - ".goreleaser.yml"
    - "examples/"
    - ".taskfiles/"
    - "Taskfile.yml"
    - ".teraform-docs.yml"
    - ".tflint.yml"
    - "go.work"
    - "go.work.sum"
    - "**/*.txt"


  comment: on-failure # on what condition license-eye will comment on the pull request, `on-failure`, `always`, `never`.

  # license-location-threshold specifies the index threshold where the license header can be located,
  # after all, a "header" cannot be TOO far from the file start.
  license-location-threshold: 80

  language:
    Go:
      extensions:
        - ".go"
      comment_style_id: DoubleSlash
    YAML:
      extensions:
        - ".yml"
        - ".yaml"
      comment_style_id: Hashtag

{% if golang %}
dependency: 
  files: 
    - go.mod
{% endif %}
