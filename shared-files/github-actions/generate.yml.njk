{% include '../common/header.yml.tmpl' %}

{% if terraform_provider %}
name: generate

# Verifies that generated code is committed. Runs on pull requests because
# generated files must stay in sync with the sources they derive from.

on:
  pull_request:
    paths:
      - 'templates/**'
      - 'examples/**'
      - 'internal/tests/**'
      - '**.go'

concurrency:
  {#- raw is used to avoid conflicts with the templating engine and github action #}
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  generate:
    name: Generate
    # Generation only needs Go plus network access to public modules, so use a
    # GitHub-hosted runner instead of a self-hosted/ARC one.
    runs-on: ubuntu-latest
    # Fail fast if no runner picks up the job instead of queueing until the
    # platform-level timeout.
    timeout-minutes: 15
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  #v7.0.1
      - name: Setup Go
        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e  #v7.0.0
        with:
          go-version-file: 'go.mod'
      - name: Install Task
        uses: arduino/setup-task@c0bc642852239c2689f73f4ea6459c29405f3c52  #v3.0.0
      - name: Run generation
        run: task go:run
      - name: Verify generated files are committed
        run: |
          git diff --compact-summary --exit-code || \
            (echo; echo "Unexpected difference in directories after code generation. Run 'task generate' command and commit."; exit 1)
{% endif %}
