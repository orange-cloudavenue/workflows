{% include '../common/header.yml.tmpl' %}
{#- Every PR-only job must check the event name explicitly: absent
    `github.event.pull_request.*` fields evaluate to null on non-PR events and
    `null == false` is true, so draft/label conditions silently pass on push or
    dispatch runs whatever triggers the consuming workflow declares. -#}
{%- set is_pr = "github.event_name == 'pull_request'" %}
{#- Template-sync PRs (repo-file-sync-action, branches `repo-sync/*`) carry no
    source changes and can never include a changelog entry. -#}
{%- set not_sync = "!startsWith(github.event.pull_request.head.ref, 'repo-sync/')" %}

name: PR All events

on:
  pull_request:
    types: [ opened, reopened, synchronize, edited ]
{% if terraform_provider %}
  # Trusted triggers required by the tests job below.
  push:
    branches: [ main ]
  workflow_dispatch:
{% endif %}


concurrency:
  {#- raw is used to avoid conflicts with the templating engine and github action #}
  group: {% raw %}${{ github.ref }}-${{ github.head_ref }}-pr-all{% endraw %}
  cancel-in-progress: true

permissions:
  contents: write
  pull-requests: write

jobs:
  changelog-dependabot:
    if: {{ is_pr }}
    name: "Changelog Dependabot"
    uses: orange-cloudavenue/workflows/.github/workflows/changelog_dependabot.yml@main
    secrets:
      {#- raw is used to avoid conflicts with the templating engine and github action #}
      TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

  pr-size:
    if: github.event.action != 'edited' && {{ is_pr }}
    name: "PR Size"
    uses: orange-cloudavenue/workflows/.github/workflows/pr_label_size.yml@main
    with:
      ref: {% raw %}${{ github.ref }}{% endraw %}
      repository: {% raw %}${{ github.repository }}{% endraw %}

  pr-conventional-commits:
    if: {{ is_pr }}
    name: "Conventional Commits"
    uses: orange-cloudavenue/workflows/.github/workflows/pr_conventional_commits.yml@main

  pr-license:
    if: github.event.action != 'edited' && github.event.pull_request.draft == false && {{ is_pr }}
    name: "License Check"
    uses: orange-cloudavenue/workflows/.github/workflows/pr_license.yml@main
    with:
      ref: {% raw %}${{ github.ref }}{% endraw %}
      repository: {% raw %}${{ github.repository }}{% endraw %}

{% if changelog_validation %}
  changelog-validation:
    if: github.event.action != 'edited' && github.event.pull_request.draft == false && !contains(github.event.pull_request.labels.*.name, 'skip-changelog') && {{ is_pr }} && {{ not_sync }}
    name: "Changelog Validation"
    uses: orange-cloudavenue/workflows/.github/workflows/changelog_validation.yml@main
    with:
      ref: {% raw %}${{ github.ref }}{% endraw %}
      repository: {% raw %}${{ github.repository }}{% endraw %}
    secrets:
      TOKEN: {% raw %}${{ secrets.PR_CI_PAT }}{% endraw %}
{% endif %}
{% if golang %}
  go-license-check:
    if: github.event.action != 'edited' && github.event.pull_request.draft == false && {{ is_pr }}
    name: "Go Dependency License Check"
    uses: orange-cloudavenue/workflows/.github/workflows/go_license-check.yml@main
    with:
      ref: {% raw %}${{ github.ref }}{% endraw %}
      repository: {% raw %}${{ github.repository }}{% endraw %}
{% endif %}

{% if golang %}
  golang-ci-lint:
    if: github.event.action != 'edited' && github.event.pull_request.draft == false && {{ is_pr }}
    {% include './common/golang/lint.tmpl' %}

  tests:
    {% if terraform_provider %}
    # Privileged integration tests: trusted-trigger runs only.
    if: github.event_name != 'pull_request'
    {% include './common/golang/unit-test-tf-provider.tmpl' %}
    {% else %}
    if: github.event.action != 'edited' && github.event.pull_request.draft == false && {{ is_pr }}
    {% include './common/golang/unit-test.tmpl' %}

    {% endif %}
{% endif %}
